# Copy this file to .env and fill in your keys. Never commit .env.
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
# Optional: only voice requests need it (speech to text)
XAI_API_KEY=
# Optional: true saves every answer and replays it for the same request, so a rehearsed
# demo is instant and the same every time. Delete server/demo-cache.json to start over.
DEMO_CACHE=false
